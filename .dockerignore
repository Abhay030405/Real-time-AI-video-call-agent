# Keep secrets, documents, tests data and web files out of the agent image
.env
.env.*
!.env.example
**/.env
**/.env.*
!.env.example
.git
docs/
evals/
!evals/datasets/l2_single_replies/
ops/
infra/
scripts/
web/
**/__pycache__/
**/.venv/
**/.pytest_cache/
**/*.wav
# ... except Vaani's own pre-recorded clips, which the agent needs
!assets/audio/**/*.wav
**/*.mp4
**/*.mov
**/*.webm

# Local recordings must never enter an image
storage/
