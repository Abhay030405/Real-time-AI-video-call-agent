# Secrets: never committed (templates are .env.example)
.env
.env.*
!.env.example
web/.env
web/.env.*
!web/.env.example

# Recorded test material lives in the private R2 bucket, not in the repository.
# Only the file lists and consent records are committed.
evals/datasets/**/*.wav
evals/datasets/**/*.mp3
evals/datasets/**/*.flac
evals/datasets/**/*.m4a
evals/datasets/**/*.mp4
evals/datasets/**/*.mov
evals/datasets/**/*.webm

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Web
web/node_modules/
web/.next/
web/out/

# Editors and system files
.DS_Store
.idea/
.vscode/
