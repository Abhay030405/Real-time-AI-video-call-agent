# Vaani web page settings.
# Copy this file to `.env` and fill in the values. `.env` is never committed.
#
# RULE: any name starting with NEXT_PUBLIC_ is sent to the person's browser.
# Never put a key or secret behind NEXT_PUBLIC_. Everything else here is
# used only by the page's own server side.

# --- Server side only: mints the short-lived access pass for each call ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Safe to send to the browser ---
NEXT_PUBLIC_APP_ENV=development
