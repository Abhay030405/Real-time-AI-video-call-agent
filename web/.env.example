# Vaani web page settings (server side only).
# Copy this file to `.env` and fill in the values. `.env` is never committed.
# Only web/lib/settings.ts reads this file.
#
# RULE: any name starting with NEXT_PUBLIC_ is sent to the person's browser.
# Never put a key or secret behind NEXT_PUBLIC_. Nothing below uses it.

# Calls can start only when this is "development" (Phase 1 is local only)
APP_ENV=development

# --- Mints the short-lived access pass for each call ---
# LIVEKIT_URL is the address the BROWSER uses. Local server: ws://localhost:7880
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# How long one call's access pass stays valid, in seconds
TOKEN_TTL_SECONDS=600

# Empty: LiveKit starts the agent automatically for every new room
AGENT_NAME=
