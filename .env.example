# Vaani — server-side settings for the agent, evals and scripts.
# Copy this file to `.env` and fill in the values. `.env` is never committed.
# Only secrets and connection details go here. Tunable numbers (timeouts,
# thresholds, the session clock) live in versioned config so every result
# record knows which values were used.

APP_ENV=development

# --- Call layer (LiveKit Cloud, Mumbai agent region) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Speech-to-text (Sarvam, only service, no backup — RE-D9) ---
SARVAM_API_KEY=

# --- Voice (Cartesia primary, Sarvam Bulbul backup uses SARVAM_API_KEY — RE-D7) ---
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# --- Brain (M1 direct, M2 through OpenRouter, S1 helper — chosen in Phase 1) ---
M1_PROVIDER=
M1_MODEL=
M1_API_KEY=
OPENROUTER_API_KEY=
M2_MODEL=
S1_PROVIDER=
S1_MODEL=
S1_API_KEY=

# --- Decision model (Jev by TypeSafe — RE-D4, RE-D10) ---
TYPESAFE_API_KEY=
JEV_MODEL=

# --- Avatar (LemonSlice — Phase 4) ---
LEMONSLICE_API_KEY=

# --- Data (Phase 3) ---
DATABASE_URL=
REDIS_URL=

# --- Test material storage (local folders, outside the project) ---
# Recordings live in a folder OUTSIDE this repository so they can never be committed
# or copied into a Docker image. A second copy lives on an external drive.
# Cloud storage in India is chosen again before Phase 4.
TEST_MATERIAL_DIR=
TEST_MATERIAL_BACKUP_DIR=

# --- Evaluation (AI judge: a different model family from M1) ---
JUDGE_PROVIDER=
JUDGE_MODEL=
JUDGE_API_KEY=
