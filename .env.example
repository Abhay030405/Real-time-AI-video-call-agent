# Vaani — server-side settings for the agent, evals and scripts.
# Copy this file to `.env` and fill in the values. `.env` is never committed.
# Every value that can change goes here: keys, addresses, model names, voice IDs,
# folder paths and tunable numbers (timeouts, thresholds, the session clock).
# Only agent/settings/ reads this file. Result records save the non-secret values.

APP_ENV=development
# Empty: LiveKit sends every new room to the agent automatically
AGENT_NAME=

# --- Call layer (LiveKit Cloud, Mumbai agent region) ---
# Local server (docker compose up livekit): ws://localhost:7880. LiveKit Cloud: its wss:// address.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Speech-to-text (Sarvam realtime, only service, no backup — RE-D9) ---
SARVAM_API_KEY=
# translit writes Hindi in Roman letters ("Haan yaar"), which the brain reads and writes
SARVAM_STT_MODE=translit
# auto lets Sarvam detect English, Hindi or a mix
SARVAM_STT_LANGUAGE=auto
SARVAM_STT_STREAM_TYPE=balanced
# Empty in normal use; the fault checks set it to a dead address to test the failure rule
SARVAM_STT_URL=

# --- Voice (Cartesia primary, Sarvam Bulbul backup uses SARVAM_API_KEY — RE-D7) ---
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=28ca2041-5dda-42df-8123-f58ea9c3da00
CARTESIA_MODEL=sonic-3.6
CARTESIA_LANGUAGE=hi
CARTESIA_SAMPLE_RATE=24000
# Word timestamps are not supported for Hindi on this model; they are not needed yet
CARTESIA_WORD_TIMESTAMPS=false
# Backup voice (Sarvam Bulbul) used only when Cartesia fails
BULBUL_MODEL=bulbul:v3
BULBUL_SPEAKER=priya
BULBUL_LANGUAGE=hi-IN

# --- Brain ---
# M1 is called directly. With M1_PROVIDER=sarvam it uses SARVAM_API_KEY (leave M1_API_KEY empty).
M1_PROVIDER=sarvam
M1_MODEL=sarvam-105b-conversations
M1_BASE_URL=https://api.sarvam.ai/v1
M1_API_KEY=
# M2 (fallback brain) always goes through OpenRouter.
OPENROUTER_API_KEY=
M2_MODEL=google/gemini-3.5-flash-lite
# S1 (helper for background jobs). With S1_PROVIDER=openrouter it uses OPENROUTER_API_KEY.
S1_PROVIDER=openrouter
S1_MODEL=google/gemini-3.1-flash-lite
S1_API_KEY=

# --- Decision model (Jev by TypeSafe — RE-D4, RE-D10) ---
TYPESAFE_API_KEY=
JEV_MODEL=

# --- Avatar (LemonSlice — Phase 4) ---
LEMONSLICE_API_KEY=

# --- Data (Phase 3) ---
DATABASE_URL=
REDIS_URL=

# --- Test material storage (local folders inside the project, ignored by git and Docker) ---
# Recordings are never pushed. Main copy and a backup copy; the backup is copied
# to an external drive from time to time. Cloud storage in India is chosen again before Phase 4.
TEST_MATERIAL_DIR=storage/main
TEST_MATERIAL_BACKUP_DIR=storage/backup

# --- Evaluation (AI judge: a different model family from M1) ---
JUDGE_PROVIDER=
JUDGE_MODEL=
JUDGE_API_KEY=

# Length of a session in minutes (the session clock itself is built in Phase 3)
SESSION_MINUTES=20

# --- Turn taking ---
# multilingual (LiveKit's turn detector), vad, stt or manual. manual is the version 0.5 plug-in point.
TURN_DETECTION=multilingual
# Speech shorter than this does not count as a turn when checking that Sarvam answered
STT_MIN_SPEECH_S=1.0

# --- Reliability numbers (versioned with the result records; see V0_04 section 9 and RE-D9) ---
# A short "hmm" plays if the brain has no first word after this many seconds
FILLER_AFTER_S=1.0
# Switch from M1 to M2 if M1 has no first word after this many seconds
M1_SWITCH_AFTER_S=1.5
# M2 gets longer, because it only runs when M1 has already failed
M2_FIRST_WORD_LIMIT_S=5.0
# After this many M1 failures in a row, stay on M2 ...
M1_FAILS_BEFORE_BREAKER=2
# ... for this many minutes before trying M1 again
M2_STAY_MINUTES=5
# Speech-to-text: this many errors in a row end the call with an apology
STT_FAILS_IN_A_ROW=2
# Speech-to-text: no answer at all for this many seconds ends the call with an apology
STT_NO_RESPONSE_LIMIT_S=5
# How long the rejoin link stays valid after a clean end
REJOIN_VALID_MINUTES=30

# --- Telemetry: timing and cost of every turn (timings and numbers only, never what was said) ---
TELEMETRY_DIR=storage/telemetry
# Prices stay in the vendor's own currency. Confirm each on the vendor's price page;
# the units (tokens, characters, seconds) are always logged too, so costs can be recomputed.
USD_INR=88.0
USD_INR_DATE=2026-10-19
# M1 sarvam-105b-conversations (the 105b pages list two different price sets; this is the higher)
PRICE_M1_INPUT_INR_PER_M=29.28
PRICE_M1_OUTPUT_INR_PER_M=73.2
# M2 and S1 through OpenRouter (read from its model list on 2026-10-19)
PRICE_M2_INPUT_USD_PER_M=0.3
PRICE_M2_OUTPUT_USD_PER_M=2.5
PRICE_S1_INPUT_USD_PER_M=0.25
PRICE_S1_OUTPUT_USD_PER_M=1.5
PRICE_SARVAM_STT_INR_PER_HOUR=30
PRICE_BULBUL_INR_PER_10K_CHARS=30
# Estimate: Pro plan $5 for 100K credits at 1 credit per character (sources disagree; confirm)
PRICE_CARTESIA_USD_PER_1K_CHARS=0.05

# --- Rules check (plain code, runs before every reply) ---
# The first minutes of a call: warm, no teasing
RULES_OPENING_MINUTES=2
# From this minute Vaani starts closing the conversation naturally
RULES_WRAP_UP_MINUTE=17
# After a crisis phrase, the safety override stays on for this many replies
RULES_CRISIS_TURNS=5
# Jev alone ends the call for "under 18" only at or above this probability
RULES_JEV_UNDER_18_THRESHOLD=0.9

# --- Evaluation runs ---
# Pause between model requests so long runs do not hit rate limits
EVAL_MIN_SECONDS_BETWEEN_CALLS=1.0
# How often a test case is tried again after a rate-limit error (tests only, never live calls)
EVAL_RETRIES_ON_RATE_LIMIT=3

# A skill enters the chooser only with at least this many test cases (hard rule 6)
SKILL_MIN_TEST_CASES=30

# --- Jev decisions in the background (never on the reply path) ---
JEV_ENABLED=true
# Jev gets this long to answer; if it is slower the call simply keeps the current skill
JEV_TIMEOUT_S=3.0
# How many recent exchanges Jev reads
JEV_WINDOW_TURNS=4
# The skill changes only when Jev's probability for a new skill is at least this
SKILL_SWITCH_THRESHOLD=0.7
# Jev's "heavy moment" and "hinted crisis" answers act at or above these probabilities
JEV_HEAVY_THRESHOLD=0.6
JEV_CRISIS_THRESHOLD=0.5

# --- Consent ---
# The agent starts a call only if the person agreed to one of these wordings (comma separated)
ACCEPTED_CONSENT_VERSIONS=consent_v1
